# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# MapLibre worker copies are generated by postinstall/prebuild — keep in git
# so Vercel builds work even if scripts skip; do not ignore public/maplibre/

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
.env
.env.local
.env.*.local
!.env.example
.env.vercel.prod.check
.env.deploy.local
**/\.env.deploy.local

# API / OAuth credential dumps (never commit)
credentials.json
**/credentials.json
deploy/opensky-proxy/.env.deploy.local

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

.env.vercel.pull
.env*.local
