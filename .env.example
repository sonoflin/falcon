# OpenSky Network OAuth2 client credentials (recommended)
# Create at https://opensky-network.org/ → Account → API clients
# Anonymous access works with lower rate limits.
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=

# Optional: Cloudflare Worker egress proxy when the host cannot reach
# auth.opensky-network.org (common on Vercel). Worker holds OpenSky secrets;
# Falcon calls the proxy with OPENSKY_PROXY_SECRET.
# OPENSKY_PROXY_URL=https://falcon-opensky-proxy.<account>.workers.dev
# OPENSKY_PROXY_SECRET=

# Optional: set to 1 only for offline UI work with synthetic tracks
# DEMO_MODE=0
