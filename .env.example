# OpenSky Network OAuth2 client credentials (recommended)
# Create at https://opensky-network.org/ → Account → API clients
# Anonymous access works with lower rate limits.
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=

# Preferred on Vercel when datacenter IPs cannot reach OpenSky:
# server-side HTTP CONNECT egress (residential / allowlisted proxy).
# NEVER set NEXT_PUBLIC_* for these. Split vars preferred over a full URL.
# OPENSKY_EGRESS_PROXY_HOST=proxy.example.com
# OPENSKY_EGRESS_PROXY_PORT=31112
# OPENSKY_EGRESS_PROXY_USER=
# OPENSKY_EGRESS_PROXY_PASS=
# OPENSKY_EGRESS_PROXY_URL=http://user:pass@host:port

# Optional: Falcon application proxy (secret-gated, path-allowlisted).
# Prefer OPENSKY_EGRESS_PROXY_* on Vercel; use this only for a dedicated host
# that can reach OpenSky (or that itself uses CONNECT egress).
# OPENSKY_PROXY_URL=https://falcon-opensky-proxy.example.com
# OPENSKY_PROXY_SECRET=

# Optional: set to 1 only for offline UI work with synthetic tracks
# DEMO_MODE=0
